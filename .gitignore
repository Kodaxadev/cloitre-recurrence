# Local agent/editor state
.claude/

# Reproducible build and interpreter caches
**/target/
**/__pycache__/
.lake/
*.py[cod]

# Large generated row-by-row scans. Their hashes belong in the evidence
# manifest; compact certificates, logs, census files, and profiles stay tracked.
data/scan_*.csv

# Compiled manuscript PDFs. These are build outputs, regenerable from
# manuscript/arxiv/ with two pdflatex passes, so they are not tracked; the
# release should attach one rather than the branch carrying several.
cloitre_arxiv_*_compiled.pdf
manuscript/arxiv/*.pdf
manuscript/arxiv/*.aux
manuscript/arxiv/*.log
manuscript/arxiv/*.out
manuscript/arxiv/build-*/

# Platform noise
.DS_Store
Thumbs.db
